# Local development uses a process-local Firestore-shaped stub (no cloud access).
DATA_STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=heart-alignment-local
FIRESTORE_DATABASE=(default)
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# ── Firebase Local Emulator Suite ────────────────────────────────────────────
# 啟動 Emulator：cmd /c "firebase emulators:start"
# 啟動後 Firestore UI：http://127.0.0.1:4000
#
# 切換至 Emulator（取消以下三行的 # 並注解掉 DATA_STORE_BACKEND=memory）：
# DATA_STORE_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GOOGLE_CLOUD_PROJECT=heart-alignment-local

# To use Google Cloud Firestore, set DATA_STORE_BACKEND=firestore,
# GOOGLE_CLOUD_PROJECT=<your-project-id>, then configure ADC outside this file.

# Frontend-only configuration. Never put secrets in VITE_* variables.
# Replace with a long random secret before exposing the admin page.
ADMIN_API_TOKEN=change-me-local-only
ADMIN_AUTH_MODE=token
ADMIN_FIREBASE_CLAIM=admin
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=false
VITE_ADMIN_AUTH_MODE=token
# Public Firebase Web App configuration (not secret values).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# OpenAI – set your key here (never commit the real key to git)
OPENAI_API_KEY=sk-...
# Optional overrides (defaults shown):
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1024
